# Configure these in the PHP process environment; this file is NOT auto-loaded.
# Recommended: TMDB API Read Access Token (Bearer), not a user/session token.
TMDB_READ_ACCESS_TOKEN=
# Alternative v3 API key; unnecessary when the read access token is configured.
TMDB_API_KEY=
# Use the SAME absolute database path as your existing installation.
# APP_DB_PATH=/absolute/path/to/var/app.sqlite
